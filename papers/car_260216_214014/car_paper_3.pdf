    <meta name="journal_id" content="41423"/>
    <meta name="dc.title" content="CAR-T and CAR-NK as cellular cancer immunotherapy for solid tumors"/>
    <meta name="dc.source" content="Cellular &amp; Molecular Immunology 2024 21:10"/>
