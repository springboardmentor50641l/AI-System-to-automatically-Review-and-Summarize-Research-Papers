    <meta name="journal_id" content="41467"/>
    <meta name="dc.title" content="Quantum machine learning with Adaptive Boson Sampling via post-selection"/>
    <meta name="dc.source" content="Nature Communications 2025 16:1"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="Nature Publishing Group"/>
    <meta name="dc.date" content="2025-01-21"/>
